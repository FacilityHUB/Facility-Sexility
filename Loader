local DISCORD_CODE = "jTuXv2Kcsn"
local DISCORD_EVERY = 24 * 60 * 60
local DISCORD_STAMP = "Facility/discord.txt"

local function discordInvite()
	if shared.FacilityInvited then return end
	shared.FacilityInvited = true

	local send = request or http_request or (http and http.request) or (syn and syn.request)
	if type(send) ~= "function" then return end

	if canWrite then
		local last = 0
		pcall(function()
			if isfile(DISCORD_STAMP) then last = tonumber(readfile(DISCORD_STAMP)) or 0 end
		end)
		if os.time() - last < DISCORD_EVERY then return end
		pcall(writefile, DISCORD_STAMP, tostring(os.time()))
	end

	pcall(send, {
		Url = "http://127.0.0.1:6463/rpc?v=1",
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json",
			["Origin"] = "https://discord.com",
		},
		Body = game:GetService("HttpService"):JSONEncode({
			cmd = "INVITE_BROWSER",
			args = { code = DISCORD_CODE },
			nonce = tostring(tick()),
		}),
	})
end

