local overrideStyle = tabStyle == "side" or tabStyle == "top"
if overrideStyle or combine then
	local originalWindow = Library.Window
	local function remember(window, ...)
		gameWindow = gameWindow or window
		return window, ...
	end
	local function configuredWindow(self, options, ...)
		if overrideStyle then
			options = table.clone(options or {})
			options.TabStyle = tabStyle
		end
		return remember(originalWindow(self, options, ...))
	end
	Library.Window = configuredWindow
	restoreWindow = function()
		if Library.Window == configuredWindow then Library.Window = originalWindow end
	end
end

