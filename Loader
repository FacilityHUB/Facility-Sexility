		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 122),
		BackgroundColor3 = THEME.Window,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = gui,
	}, {
		corner(6),
		new("UIStroke", { Color = THEME.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	local scale = new("UIScale", { Scale = 0.94, Parent = card })

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -80, 0, 18),
		Font = THEME.FontMedium,
		TextSize = 14,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.TextBright,
		Text = string.format('%s<font color="#%s">%s</font>', opts.Title or "Facility", THEME.Accent:ToHex(), opts.Suffix or ".Sexility"),
		Parent = card,
	})

	local percent = new("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 12),
		Size = UDim2.fromOffset(60, 18),
		Font = THEME.FontMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = THEME.TextDim,
		Text = "0%",
		Parent = card,
	})

	new("Frame", {
		BackgroundColor3 = THEME.BorderSoft,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = card,
	})

	local status = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 54),
		Size = UDim2.new(1, -32, 0, 16),
		Font = THEME.Font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		RichText = true,
		TextColor3 = THEME.Text,
		Text = "Starting",
		Parent = card,
	})

	local track = new("Frame", {
		BackgroundColor3 = THEME.Track,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 80),
		Size = UDim2.new(1, -32, 0, 4),
		ClipsDescendants = true,
		Parent = card,
	}, { corner(2) })

	local fill = new("Frame", {
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}, { corner(2) })

	local shine = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 40, 1, 0),
		Position = UDim2.new(-0.3, 0, 0, 0),
		Parent = fill,
	}, {
		new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	local footer = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 94),
		Size = UDim2.new(1, -92, 0, 14),
		Font = THEME.Font,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = THEME.TextDim,
		Text = "",
		Parent = card,
	})

	local timer = new("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 94),
		Size = UDim2.fromOffset(70, 14),
		Font = THEME.Font,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = THEME.TextDim,
		Text = "0.0s",
		Parent = card,
	})

	gui.Parent = guiParent()
	tween(card, 0.35, { GroupTransparency = 0 })
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

	local baseText = "Starting"
	local ticks = 0

	local function render(text)
		local folder, name = string.match(text, "^(.*/)([^/]+)$")
		if not folder then return text end
		return string.format('<font color="#%s">%s</font><font color="#%s">%s</font>', THEME.TextDim:ToHex(), folder, THEME.TextBright:ToHex(), name)
	end

	local connection = RunService.RenderStepped:Connect(function(dt)
		if not state.alive then return end
		ticks = ticks + dt
		if not state.failed then
			local dots = string.rep(".", math.floor(ticks * 3) % 4)
			status.Text = render(baseText) .. dots
			timer.Text = string.format("%.1fs", os.clock() - state.started)
		end
		local x = (ticks * 0.9) % 1.6 - 0.3
		shine.Position = UDim2.new(x, 0, 0, 0)
	end)

	local api = {}

	function api:Set(text, progress)
		if not state.alive or state.failed then return end
		baseText = text or baseText
		if progress then
			state.progress = math.clamp(progress, 0, 1)
			tween(fill, 0.4, { Size = UDim2.fromScale(state.progress, 1) })
			percent.Text = math.floor(state.progress * 100 + 0.5) .. "%"
		end
		footer.Text = state.step > 0 and string.format("step %d / %d", state.step, total) or ""
		task.wait()
	end

	function api:Step(text)
		state.step = math.min(state.step + 1, total)
		self:Set(text, state.step / total * 0.95)
	end

	function api:Error(message)
		if not state.alive then return end
		state.failed = true
		status.RichText = false
		status.Text = tostring(message)
		status.TextColor3 = THEME.Danger
		fill.BackgroundColor3 = THEME.Danger
		percent.TextColor3 = THEME.Danger
		percent.Text = "error"
		footer.Text = "closing in 6s"
		task.delay(6, function() api:Close() end)
	end

	function api:Close()
		if not state.alive then return end
		state.alive = false
		tween(card, 0.3, { GroupTransparency = 1 })
		tween(scale, 0.3, { Scale = 0.96 })
		task.delay(0.35, function()
			connection:Disconnect()
			gui:Destroy()
		end)
	end

	function api:Done(text)
		if not state.alive or state.failed then return end
		state.step = total
		baseText = text or "Ready"
		tween(fill, 0.3, { Size = UDim2.fromScale(1, 1) })
		percent.Text = "100%"
		footer.Text = string.format("loaded in %.1fs", os.clock() - state.started)
		task.delay(0.6, function() api:Close() end)
	end

	task.wait()
	return api
end

