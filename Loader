local function notify(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 8,
		})
	end)
end

local function withTimeout(call, timeout)
	local done, ok, result = false, false, nil

	task.spawn(function()
		ok, result = pcall(call)
		done = true
	end)

	local deadline = tick() + (timeout or 8)
	repeat task.wait() until done or tick() > deadline

	if not done then return false, "timeout" end
	return ok, result
end

local canWrite = false
pcall(function()
	canWrite = writefile ~= nil and readfile ~= nil and isfile ~= nil and makefolder ~= nil
end)

local function ensureFolders()
	if not canWrite then return end
	pcall(function()
		if not isfolder("Facility") then makefolder("Facility") end
	end)
end

local function fetch(base, path, timeout)
	local url = base .. path .. "?v=" .. tostring(tick()):gsub("%.", "")

	local ok, body = withTimeout(function()
		local fine, result = pcall(game.HttpGet, game, url, true)
		if fine and type(result) == "string" then return result end
		return game:HttpGet(url)
	end, timeout)

	if ok and type(body) == "string" and #body > 64
		and not body:find("404: Not Found", 1, true) then
		return body
	end

	return nil, tostring(body)
end

local function run(source, label, waitForReturn)
	local chunk, err = loadstring(source)
	if type(chunk) ~= "function" then
		return false, "compile error in " .. label .. ": " .. tostring(err)
	end

	if waitForReturn then return pcall(chunk) end

	local finished, ok, runErr = false, false, nil

	task.spawn(function()
		ok, runErr = pcall(chunk)
		finished = true
	end)

	local deadline = tick() + 3
	repeat task.wait() until finished or tick() > deadline

	if finished and not ok then
		return false, "runtime error in " .. label .. ": " .. tostring(runErr)
	end
	return true
end

local function loadModule(base, path, label)
	if DEV and canWrite then
		local localPath = "facility_dev/" .. path:gsub("[/\\]", "_")
		local source
		pcall(function()
			if isfile(localPath) then source = readfile(localPath) end
		end)
		if source then
			local chunk = loadstring(source)
			if chunk then
				warn("Facility: " .. label .. " loaded from " .. localPath)
				return chunk()
			end
		end
	end

	local source, err = fetch(base, path)
	if not source then
		error("Facility: could not load " .. label .. " (" .. tostring(err) .. ")", 0)
	end

	local chunk, compileErr = loadstring(source)
	if type(chunk) ~= "function" then
		error("Facility: " .. label .. " does not compile: " .. tostring(compileErr), 0)
	end

	return chunk()
end

if shared.Facility and shared.Facility.Loaded then
	if shared.Facility.StopUniversal then pcall(shared.Facility.StopUniversal) end
	if shared.Facility.RestoreWindow then pcall(shared.Facility.RestoreWindow) end
	pcall(function() shared.Facility.Library:Destroy() end)
	pcall(function() shared.Facility.Esp:Unload() end)
	pcall(function() shared.Facility.Entity:Stop() end)
	shared.Facility = nil
end

ensureFolders()

local DISCORD_CODE = "jTuXv2Kcsn"
local DISCORD_EVERY = 24 * 60 * 60
local DISCORD_STAMP = "Facility/discord.txt"

local function discordInvite()
	if shared.FacilityInvited then return end
	shared.FacilityInvited = true

	local send = request or http_request or (http and http.request) or (syn and syn.request)
	if type(send) ~= "function" then return end

	if canWrite then
		local last = 0
		pcall(function()
			if isfile(DISCORD_STAMP) then last = tonumber(readfile(DISCORD_STAMP)) or 0 end
		end)
		if os.time() - last < DISCORD_EVERY then return end
		pcall(writefile, DISCORD_STAMP, tostring(os.time()))
	end

	pcall(send, {
		Url = "http://127.0.0.1:6463/rpc?v=1",
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json",
			["Origin"] = "https://discord.com",
		},
		Body = game:GetService("HttpService"):JSONEncode({
			cmd = "INVITE_BROWSER",
			args = { code = DISCORD_CODE },
			nonce = tostring(tick()),
		}),
	})
end

task.spawn(discordInvite)

local Library = loadModule(UI_BASE, "main.luau", "interface")
Library.BaseUrl = UI_BASE

local restoreWindow, gameWindow
local overrideStyle = tabStyle == "side" or tabStyle == "top"
if overrideStyle or combine then
	local originalWindow = Library.Window
	local function remember(window, ...)
		gameWindow = gameWindow or window
		return window, ...
	end
	local function configuredWindow(self, options, ...)
		if overrideStyle then
			options = table.clone(options or {})
			options.TabStyle = tabStyle
		end
		return remember(originalWindow(self, options, ...))
	end
	Library.Window = configuredWindow
	restoreWindow = function()
		if Library.Window == configuredWindow then Library.Window = originalWindow end
	end
end

local Entity = loadModule(HUB_BASE, "Libraries/Entity.luau", "entity handler")
Entity:Start()

shared.Facility = {
	Loaded  = true,
	Version = "1.0.0",
	Dev     = DEV,

	Library = Library,
	RestoreWindow = restoreWindow,
	Entity  = Entity,

	UiBase  = UI_BASE,
	HubBase = HUB_BASE,

	Load = function(path, label)
		return loadModule(moduleBase, path, label or path)
	end,
}

shared.Facility.Esp = loadModule(HUB_BASE, "CModules/FEsp.luau", "esp")

local okWebhook, Webhook = pcall(function()
	return loadModule(HUB_BASE, "Libraries/Webhook.luau", "webhook")
end)

if okWebhook and type(Webhook) == "table" then
	shared.Facility.Webhook = Webhook
end

if DEV then
	warn("Facility: PlaceId " .. tostring(game.PlaceId)
		.. ", GameId " .. tostring(game.GameId))
end

local path, label, source
if not forceUniversal then
	local entry = GAMES[game.PlaceId] or GAMES[game.GameId]

	local candidates = {}

	if entry then
		table.insert(candidates, { path = entry.Script, label = entry.Title })
	end

	table.insert(candidates, { path = string.format("Games/%.0f.luau", game.PlaceId), label = string.format("place %.0f", game.PlaceId) })
	table.insert(candidates, { path = string.format("Games/%.0f.luau", game.GameId), label = string.format("game %.0f", game.GameId) })

	for _, candidate in ipairs(candidates) do
		source = fetch(HUB_BASE, candidate.path, 6)
		if source then
			path, label = candidate.path, candidate.label
			break
		end
	end

	path = path or candidates[#candidates].path
	label = label or candidates[#candidates].label

	if DEV and canWrite and entry and entry.Dev then
		pcall(function()
			if isfile(entry.Dev) then
				source = readfile(entry.Dev)
				warn("Facility: game script loaded from " .. entry.Dev)
			end
		end)
	end
end

local supported = source ~= nil
if not source then
	path, label = "Games/Universal.luau", "universal"
	source = fetch(HUB_BASE, path, 6)
	if not source and HUB_BASE ~= universalBase then
		source = fetch(universalBase, path, 6)
		if source then
			moduleBase = universalBase
			shared.Facility.HubBase = moduleBase
		end
	end
	if not source then
		notify("Facility", "Could not load Universal.", 10)
		error("Facility: could not load " .. path .. " from " .. HUB_BASE .. " or " .. universalBase, 0)
	end
end

if Webhook and LOG_WEBHOOK ~= "" then
	task.spawn(function()
		local logger = Webhook.new(LOG_WEBHOOK, { Username = "Facility" })
		logger:Player({
			Title = forceUniversal and "Universal requested" or (supported and "Supported game" or "Unsupported game"),
			Color = supported and Webhook.Colors.Green or Webhook.Colors.Red,
			Fields = {
				{
					Name = "Supported",
					Value = forceUniversal and "Not checked" or (supported and "Yes" or "No"),
					Inline = true,
				},
				{
					Name = "Script",
					Value = supported and path or "Games/Universal.luau",
					Inline = true,
				},
			},
		})
	end)
end

local session = shared.Facility
local attachUniversal = combine and supported
local ok, err = run(source, label, attachUniversal)

if not ok then
	notify("Facility", "Loading failed, see the console.", 10)
	warn(err)
	return
end

if attachUniversal then
	if shared.Facility ~= session then return end
	local function attach()
		assert(gameWindow and type(gameWindow.Tab) == "function", "the game script did not open a Facility window")
		local universalPath = "Games/Universal.luau"
		-- An older Universal would create a second window and reset the save managers.
		local marker = "-- FacilityUniversal: embedded-v1"
		for _, base in ipairs({HUB_BASE, universalBase}) do
			local body = fetch(base, universalPath, 6)
			if shared.Facility ~= session then return end
			if body and body:sub(1, #marker) == marker then
				local mount = assert(loadstring(body))
				mount({
					Window = gameWindow,
					Load = function(modulePath, moduleLabel)
						return loadModule(base, modulePath, moduleLabel)
					end,
				})
				return
			end
		end
		error("publish the matching Games/Universal.luau to enable combined mode", 0)
	end
	local mounted, reason = pcall(attach)
	if shared.Facility ~= session then return end
	if not mounted then
		if session.StopUniversal then pcall(session.StopUniversal) end
		notify("Facility", "Game loaded. Universal could not attach: " .. tostring(reason), 10)
		warn("Facility: " .. tostring(reason))
		return
	end
	label = label .. " + Universal"
end

notify("Facility", "Loaded for " .. label .. ".", 5)
