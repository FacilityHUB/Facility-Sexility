if attachUniversal then
	if shared.Facility ~= session then loading:Close() return end
	loading:Set("Games/Universal.luau")
	local function attach()
		assert(gameWindow and type(gameWindow.Tab) == "function", "the game script did not open a Facility window")
		local universalPath = "Games/Universal.luau"
		local marker = "-- FacilityUniversal: embedded-v1"
		for _, base in ipairs({HUB_BASE, universalBase}) do
			local body = fetch(base, universalPath, 6)
			if shared.Facility ~= session then return end
			if body and body:sub(1, #marker) == marker then
				local mount = assert(loadstring(body))
				mount({
					Window = gameWindow,
					Load = function(modulePath, moduleLabel)
						return loadModule(base, modulePath, moduleLabel)
					end,
				})
				return
			end
		end
		error("publish the matching Games/Universal.luau to enable combined mode", 0)
	end
	local mounted, reason = pcall(attach)
	if shared.Facility ~= session then loading:Close() return end
	if not mounted then
		if session.StopUniversal then pcall(session.StopUniversal) end
		notify("Facility", "Game loaded. Universal could not attach: " .. tostring(reason), 10)
		warn("Facility: " .. tostring(reason))
		loading:Error("Universal could not attach: " .. tostring(reason))
		return
	end
	label = label .. " + Universal"
end

