	for _, candidate in ipairs(candidates) do
		loading:Set(candidate.path)
		source = fetch(HUB_BASE, candidate.path, 6)
		if source then
			path, label = candidate.path, candidate.label
			break
		end
	end

	path = path or candidates[#candidates].path
	label = label or candidates[#candidates].label

	if DEV and canWrite and entry and entry.Dev then
		pcall(function()
			if isfile(entry.Dev) then
				source = readfile(entry.Dev)
				warn("Facility: game script loaded from " .. entry.Dev)
